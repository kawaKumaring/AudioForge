node_modules/
out/
dist/
*.log
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo

# Work files and outputs
작업파일/

# External dependencies (large/generated, installed separately)
# 클론·venv·모델·env.json 등 전부 setup 스크립트로 재현 (버전관리 제외)
externals/

# Environment
.env
.env.local
scratch_e2e/

# 참조 혼입 진단 산출물 — WAV/토큰 덤프/전사는 저장소에 넣지 않는다.
# 계측 스크립트(.py)만 추적하고, 산출물은 manifest 로만 기록한다.
tmp_leak_analysis/*
!tmp_leak_analysis/*.py
tmp_leak_analysis/*PRIVATE*

# ── 로컬 전용 자산 루트 (Git 절대 비추적) ───────────────────────────────
# AudioForge 가 개발·검증에 쓰는 실물 자산의 단일 권위 위치.
#   assets/    originals·references·golden — 읽기 전용, 앱 자동정리 대상 아님
#   artifacts/ generated·diagnostics·drafts·recovery
#   runtime/   models·venvs·hf-cache·downloads
#   manifests/ 절대경로가 든 인벤토리 — 커밋 금지
# 음성·모델·venv·전사·토큰이 저장소로 새지 않게 하는 것이 이 규칙의 목적이다.
# worktree 안에는 _local 을 만들지 않는다 — 본체 저장소의 실체를 설정 경로로 참조한다.
/_local/
