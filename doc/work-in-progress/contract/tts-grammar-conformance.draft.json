{
  "_meta": {
    "purpose": "TTS 감정/쉼 문법 언어중립 conformance 벡터(초안). TS parser와 Python parser가 둘 다 통과해야 한다. 통합 담당이 scaffold 단계에서 실제 테스트 경로로 이동·배선한다. 대사 전문은 테스트 입력에만 존재하고 metadata/로그로 나가지 않는다.",
    "parser_version": 1,
    "status": "draft — D 계약 미결정(D-2/D-4/D-7) 확정 후 고정",
    "emotion_ok_note": "emotion_id는 emotions.ts ALL_EMOTIONS(한글 label + 영문 id)에서 주입. 아래 happy/cheerful 등은 예시.",
    "pause_range_seconds": [0.05, 5.0]
  },
  "valid": [
    {
      "name": "single leading emotion",
      "input": "[기쁨] 안녕하세요.",
      "segments": [
        { "original_line_index": 0, "raw_start_offset": 0, "raw_end_offset": 11, "emotion_id": "happy", "spoken_text": "안녕하세요.", "pauses": [] }
      ],
      "used_emotion_ids": ["happy"]
    },
    {
      "name": "inline multi-emotion one line (caret insert 결과 형태)",
      "input": "[기쁨] 안녕하세요. [명랑] 오늘 날씨가 좋아요.",
      "segments": [
        { "original_line_index": 0, "raw_start_offset": 0, "raw_end_offset": 17, "emotion_id": "happy", "spoken_text": "안녕하세요. ", "pauses": [] },
        { "original_line_index": 0, "raw_start_offset": 17, "raw_end_offset": 38, "emotion_id": "cheerful", "spoken_text": "오늘 날씨가 좋아요.", "pauses": [] }
      ],
      "used_emotion_ids": ["happy", "cheerful"],
      "note": "offset은 원문 문자 인덱스; 실제 값은 구현이 fixture 로더에서 재계산하도록 정규화. 여기 숫자는 예시이며 D-7 확정 시 고정."
    },
    {
      "name": "english id alias",
      "input": "[happy] hello world",
      "segments": [
        { "original_line_index": 0, "emotion_id": "happy", "spoken_text": "hello world", "pauses": [] }
      ],
      "used_emotion_ids": ["happy"]
    },
    {
      "name": "explicit pause overrides boundary gap (not sum)",
      "input": "[기쁨] 첫 문장. [쉼 0.5] 둘째 문장.",
      "segments": [
        { "original_line_index": 0, "emotion_id": "happy", "spoken_text": "첫 문장. ", "pauses": [] },
        { "original_line_index": 0, "emotion_id": "happy", "spoken_text": "둘째 문장.", "pauses": [{ "seconds": 0.5 }] }
      ],
      "used_emotion_ids": ["happy"],
      "note": "[쉼 0.5]는 그 경계의 자동 gap을 대체. 합산 아님."
    },
    {
      "name": "pause alias english + boundary min",
      "input": "A [pause 0.05] B",
      "pauses_total_seconds": 0.05
    },
    {
      "name": "no tag = default handled by reference (not an emotion token)",
      "input": "그냥 대사입니다.",
      "segments": [
        { "original_line_index": 0, "emotion_id": null, "spoken_text": "그냥 대사입니다.", "pauses": [] }
      ],
      "used_emotion_ids": [],
      "note": "선두 감정 태그 없음 → 기본 참조가 담당. emotion token 아님(used에 없음)."
    },
    {
      "name": "malformed literal (unclosed bracket) stays spoken",
      "input": "[기쁨 안녕하세요]다음",
      "segments": [
        { "original_line_index": 0, "emotion_id": null, "spoken_text": "[기쁨 안녕하세요]다음", "pauses": [] }
      ],
      "used_emotion_ids": [],
      "note": "control-tag 형식 미충족(내부 공백+비-태그) → 리터럴. 발음 텍스트."
    },
    {
      "name": "multi-line: 각 줄 감정 독립",
      "input": "[기쁨] 첫째 줄.\n[슬픔] 둘째 줄.",
      "segments": [
        { "original_line_index": 0, "emotion_id": "happy", "spoken_text": "첫째 줄.", "pauses": [] },
        { "original_line_index": 1, "emotion_id": "sad", "spoken_text": "둘째 줄.", "pauses": [] }
      ],
      "used_emotion_ids": ["happy", "sad"]
    }
  ],
  "errors": [
    {
      "name": "unknown control tag → block synth (오타 방지)",
      "input": "[명란] 오늘 날씨가 좋네요.",
      "error": { "code": "UNKNOWN_TTS_TAG", "tag": "명란", "offset": 0 },
      "note": "조용한 default 금지. tag id + offset만; 대사 전문 미포함."
    },
    {
      "name": "invalid pause: 범위 초과",
      "input": "A [쉼 9.0] B",
      "error": { "code": "INVALID_PAUSE_TAG", "arg": "9.0", "offset": 2 },
      "note": "0.05–5.0 밖 → 조용한 clamp 금지."
    },
    {
      "name": "invalid pause: 음수",
      "input": "A [쉼 -0.2] B",
      "error": { "code": "INVALID_PAUSE_TAG", "arg": "-0.2", "offset": 2 }
    },
    {
      "name": "invalid pause: 형식(콤마 소수점)",
      "input": "A [쉼 0,5] B",
      "error": { "code": "INVALID_PAUSE_TAG", "arg": "0,5", "offset": 2 },
      "note": "소수점은 '.'만."
    },
    {
      "name": "invalid pause: 비수치",
      "input": "A [쉼 잠깐] B",
      "error": { "code": "INVALID_PAUSE_TAG", "arg": "잠깐", "offset": 2 }
    },
    {
      "name": "adjacent duplicate pause (D-4 초안: 같은 경계 2개↑ → 오류)",
      "input": "A [쉼 0.2][쉼 0.3] B",
      "error": { "code": "INVALID_PAUSE_TAG", "reason": "adjacent_duplicate", "offset": 2 },
      "note": "D-4 확정 전 잠정. '정규화' 채택 시 이 케이스는 valid로 이동."
