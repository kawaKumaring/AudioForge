{
  "name": "audio-forge",
  "version": "1.0.0",
  "description": "AI-powered audio source separation tool",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "node test/e2e/synthesize.e2e.mjs && node test/e2e/single-instance.e2e.mjs && node test/e2e/reset-cleanup.e2e.mjs",
    "test:e2e:complete": "node test/e2e/synthesize-complete.e2e.mjs && node test/e2e/resynthesize.e2e.mjs",
    "test:e2e:state": "node test/e2e/single-instance.e2e.mjs && node test/e2e/session-restore.e2e.mjs",
    "test:e2e:tts-autosplit": "node test/e2e/tts-autosplit-complete.e2e.mjs",
    "test:e2e:tts-editor-ux": "node test/e2e/tts-editor-ux.e2e.mjs",
    "test:e2e:tts-pitch-capability": "node test/e2e/tts-pitch-capability.e2e.mjs",
    "test:e2e:tts-accessibility": "node test/e2e/tts-accessibility.e2e.mjs",
    "test:e2e:tts-i5-smoke": "node test/e2e/tts-i5-shell-smoke.e2e.mjs",
    "test:e2e:tts-i5b-editor": "node test/e2e/tts-i5b-editor.e2e.mjs",
    "test:e2e:tts-i5b-restore": "node test/e2e/tts-i5b-restore.e2e.mjs",
    "test:e2e:tts-i5c-detail": "node test/e2e/tts-i5c-detail.e2e.mjs",
    "test:e2e:tts-i5-preview": "node test/e2e/tts-i5-preview.e2e.mjs",
    "test:e2e:tts-result-metadata": "node test/e2e/tts-result-metadata.e2e.mjs",
    "test:e2e:tts-generation-retry": "node test/e2e/tts-generation-retry.e2e.mjs",
    "test:e2e:longform-job": "node test/e2e/longform-job.e2e.mjs",
    "test:e2e:tts-cancel-lifecycle": "node test/e2e/tts-cancel-lifecycle.e2e.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "framer-motion": "^12.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wavesurfer.js": "^7.8.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "3.0.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
